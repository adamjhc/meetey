<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for ~/.meetey/Meetey.app, which wraps the meetey-capture binary.
  The bundle exists only to give the menu bar indicators an app identity — see
  "Menu bar indicator" in CLAUDE.md. __VERSION__ is filled in at install time.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.adamjhcox.meetey</string>
    <key>CFBundleName</key>
    <string>Meetey</string>
    <key>CFBundleDisplayName</key>
    <string>Meetey</string>
    <key>CFBundleExecutable</key>
    <string>meetey-capture</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Meetey records your side of meetings you choose to record, so your own voice is in the transcript. Pause it any time from the Meetey menu bar icon.</string>
</dict>
</plist>
